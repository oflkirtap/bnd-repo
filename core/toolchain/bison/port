name="bison"
version="3.8.2"
source="https://ftp.gnu.org/gnu/bison/bison-3.8.2.tar.xz"
sha256="9dd90be8df4d0474b941e2ca14ac76d11b7ccb46edb26344b60d866178bbcc9872"
depends=("m4")

build() {
    ./configure --prefix=/usr --disable-nls --without-libtextstyle-prefix
    make
}
install() {
    make DESTDIR="$DESTDIR" \
        install-libLIBRARIES \
        install-binPROGRAMS \
        install-nodist_binSCRIPTS \
        install-dist_m4sugarDATA \
        install-dist_skeletonsDATA \
        install-dist_pkgdataDATA \
        install-aclocalDATA \
        install-man1
}
