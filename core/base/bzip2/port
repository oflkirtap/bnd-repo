name="bzip2"
version="1.0.8"
source="https://sourceware.org/pub/bzip2/bzip2-1.0.8.tar.gz"
sha256="97af3f520629c65fe41292f77e6ca798fe594d7987bfb2aebe7c6fcdc7ab5ed25e"
depends=()

build() {
    make CC="$CC $CFLAGS -fPIC $LDFLAGS" -f Makefile-libbz2_so
    make CC="$CC $CFLAGS -static -fPIC $LDFLAGS" bzip2
}

install() {
    mkdir -p "$DESTDIR/usr/bin" "$DESTDIR/usr/lib" \
             "$DESTDIR/usr/share/man/man1" "$DESTDIR/usr/include"
    cp -f bzip2 bzdiff bzgrep bzmore "$DESTDIR/usr/bin"
    cp -f libbz2.so.1.0.8 libbz2.a "$DESTDIR/usr/lib"
    cp -f bzip2.1 "$DESTDIR/usr/share/man/man1"
    cp -f bzlib.h "$DESTDIR/usr/include"
    ln -sf libbz2.so.1.0.8 "$DESTDIR/usr/lib/libbz2.so"
    ln -sf libbz2.so.1.0.8 "$DESTDIR/usr/lib/libbz2.so.1"
    ln -sf libbz2.so.1.0.8 "$DESTDIR/usr/lib/libbz2.so.1.0"
    ln -sf bzip2 "$DESTDIR/usr/bin/bunzip2"
    ln -sf bzip2 "$DESTDIR/usr/bin/bzcat"
}
