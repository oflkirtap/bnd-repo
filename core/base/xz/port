name="xz"
version="5.8.4"
source="https://excellmedia.dl.sourceforge.net/project/lzmautils/xz-5.8.4.tar.gz"
sha256="23dc35df6978754f2aff90a67634648266d46ad7b71f746a712fa1a117b56fdfc0"
depends=()

build() {
    ./configure --prefix=/usr --disable-doc --disable-nls
    make
}

install() {
    make DESTDIR="$DESTDIR" install

    # static-linking the tools, mirrors KISS
    cd src
    rm -f xz/xz lzmainfo/lzmainfo xzdec/lzmadec xzdec/xzdec
    make LDFLAGS="$LDFLAGS -all-static" -C xz
    make LDFLAGS="$LDFLAGS -all-static" -C lzmainfo
    make LDFLAGS="$LDFLAGS -all-static" -C xzdec
    for bin in xz/xz lzmainfo/lzmainfo xzdec/lzmadec xzdec/xzdec; do
        cp "$bin" "$DESTDIR/usr/bin"
        chmod 755 "$DESTDIR/usr/bin/${bin##*/}"
    done
}
